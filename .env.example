# ---- UdyamPulse configuration ----
# Every provider defaults to a local implementation. Leave Azure values empty for the offline demo.

# Auth (Entra ID in prod). Change for any shared deployment.
UP_JWT_SECRET=change-me-local-demo-secret
UP_JWT_TTL_MINUTES=480

# Storage
UP_DB_URL=sqlite:///var/udyampulse.db
UP_LAKE_DIR=lake

# Synthetic data
UP_SEED=42
UP_N_FACTORIES=500

# Provider selection: local | azure
UP_LLM_PROVIDER=template          # template | azure_openai | openai
UP_SEARCH_PROVIDER=local          # local | azure_ai_search
UP_DOC_PARSER=stub                # stub | azure_docintel
UP_CONSENT_PROVIDER=mock_aa       # mock_aa | sahamati_aa
UP_LAKE_STORE=duckdb              # duckdb | databricks
UP_EMBEDDINGS=tfidf               # tfidf | sentence_transformers

# Azure OpenAI (used only when UP_LLM_PROVIDER=azure_openai)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# OpenAI-compatible (used only when UP_LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=

# Azure AI Search / Document Intelligence (prod adapters)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=credit-policy
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=

# Data residency (enforced check: prod regions must be in India)
UP_DATA_REGION=local
