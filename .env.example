# ---- UdyamPulse configuration ----
# Every provider defaults to a local implementation. Leave Azure values empty for the offline demo.

# Auth (Entra ID in prod). Change for any shared deployment.
UP_JWT_SECRET=change-me-local-demo-secret-please-rotate-0001
UP_JWT_TTL_MINUTES=480

# Storage
UP_DB_URL=sqlite:///var/udyampulse.db
UP_LAKE_DIR=lake

# Synthetic data
UP_SEED=42
UP_N_FACTORIES=500

# Provider selection: local | azure
UP_LLM_PROVIDER=template          # template | azure_openai | openai
UP_SEARCH_PROVIDER=local          # local | azure_ai_search
UP_DOC_PARSER=stub                # stub | azure_docintel
UP_CONSENT_PROVIDER=mock_aa       # mock_aa | sahamati_aa
UP_LAKE_STORE=duckdb              # duckdb | databricks
UP_EMBEDDINGS=tfidf               # tfidf | sentence_transformers

# Azure OpenAI (used only when UP_LLM_PROVIDER=azure_openai)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# OpenAI-compatible (used only when UP_LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=

# Azure AI Search / Document Intelligence (prod adapters)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=credit-policy
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=

# Data residency (enforced check: prod regions must be in India)
UP_DATA_REGION=local

# Demo conveniences such as one-click reset: auto (on when UP_DATA_REGION=local) | on | off
UP_DEMO_MODE=auto

# Redis (cache, rate limits, idempotency keys, job queue). Leave empty for in-process fallbacks.
UP_REDIS_URL=
UP_CACHE=on
UP_CACHE_TTL_SECONDS=30
UP_RATE_LIMIT_USER_PER_MIN=600
UP_RATE_LIMIT_TENANT_PER_MIN=6000
UP_RATE_LIMIT_LOGIN_PER_MIN=30

# Background jobs (Dramatiq on Redis). auto = run a worker inside the API when UP_REDIS_URL is empty.
UP_INPROCESS_WORKER=auto
UP_WORKER_THREADS=4
UP_JOB_MAX_RETRIES=3
UP_JOB_MIN_BACKOFF_MS=1000
UP_JOB_MAX_BACKOFF_MS=60000
